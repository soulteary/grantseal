# Binaries
/license-tool
/bin/
*.exe
*.test
*.out

# goreleaser build/release output
/dist/

# Private keys MUST NEVER be committed
*.pem
*.key
*-private.*
private-*.*
issuer-*.key
# Runtime-generated example key directories (docs use ./_keys; examples use
# examples/out/keys). Never commit generated private keys.
_keys/

# Local license state / issued licenses
*.lic
*.license
/state/
rollback.state

# Example scenario outputs (generated by examples/run-scenarios.sh)
examples/out/

# Coverage / profiling
coverage.html
coverage.out
*.prof

# Go fuzz-generated corpus / crashers (seed corpus, if any, is added explicitly
# with `git add -f`; generated failing inputs must not be committed).
testdata/fuzz/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
