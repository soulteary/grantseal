{
  "ignorePatterns": [
    {
      "pattern": "^https://www\\.contributor-covenant\\.org"
    }
  ],
  "httpHeaders": [
    {
      "urls": ["https://"],
      "headers": {
        "User-Agent": "Mozilla/5.0 (compatible; markdown-link-check)",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
      }
