# Dockerfile used by goreleaser's `dockers` section.
#
# goreleaser cross-compiles the binary first and provides it in the build
# context, so this file only needs to COPY the pre-built `license-tool` into a
# minimal distroless runtime. No Go toolchain / compilation happens here.
#
# SECURITY: this image never contains private keys. Private keys stay on the
# host and are mounted at runtime (e.g. `-v $PWD/keys:/keys:ro`).

# Pinned by digest. Tag: gcr.io/distroless/static-debian13:nonroot
# This Debian 13 based static image legitimately ships tzdata (full zoneinfo
# tree), base-files, netbase and ca-certificates on top of the minimal rootfs;
# scripts/check-archive-allowlist.sh's base allowlist is scoped to exactly this
# digest's contents and MUST be re-reviewed if this digest is bumped.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7

COPY license-tool /license-tool

ENTRYPOINT ["/license-tool"]
CMD ["--help"]
